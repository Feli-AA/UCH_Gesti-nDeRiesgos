    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    r.id AS internal_id,\n    r.reference_id,\n    r.subject,\n    r.status,\n    rs.CLASSIC_likelihood AS likelihood,\n    rs.CLASSIC_impact AS impact,\n    ROUND(rs.calculated_risk, 1) AS score,\n    CASE\n        WHEN rs.calculated_risk >= 6.4 THEN 'Crítico'\n        WHEN rs.calculated_risk >= 4.0 THEN 'Alto'\n    END AS risk_level,\n    u.name AS owner,\n    CONCAT(\n        r.id,\n        '-',\n        ROUND(rs.calculated_risk, 1),\n        '-',\n        r.status\n    ) AS notification_key\nFROM risks AS r\nINNER JOIN risk_scoring AS rs\n    ON rs.id = r.id\nLEFT JOIN user AS u\n    ON u.value = r.owner\nWHERE rs.calculated_risk >= 4.0\n  AND r.status <> 'Closed'\nORDER BY rs.calculated_risk DESC, r.id ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
